# Supabase Free Tier (PostgreSQL + Auth + Storage)
# Get your free project credentials at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Virtual Try-On Microservice (Local Inference)
# Default runs on localhost:8000 using PyTorch / FastAPI
NEXT_PUBLIC_AI_VTON_ENDPOINT=http://localhost:8000/api/vton

# Base App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default Currency
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
